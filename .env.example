# ==============================================================
# VETERANPATH ENVIRONMENT CONFIGURATION EXAMPLE
# Скопіюйте цей файл у .env: cp .env.example .env
# Ніколи не комітьте .env у публічний репозиторій Git!
# ==============================================================

# Database
# Для Neon: postgresql+psycopg2://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# Для локального Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/veteranpath
# Якщо змінну не вказано, система використає вбудовану безпечну базу SQLite
DATABASE_URL=sqlite:///./veteranpath.db

# AI Engine (Google Gemini)
# Отримайте ключ на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Режим роботи: GEMINI або MOCK (MOCK працює 100% офлайн без API-ключа для бездоганного демо)
AI_MODE=MOCK

# Backend Security
SECRET_KEY=change_this_to_a_random_secret_in_production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
